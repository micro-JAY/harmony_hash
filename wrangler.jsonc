{
  "name": "harmony",
  "main": "worker/index.ts",
  "compatibility_date": "2026-04-02",
  "secrets": {
    "required": ["OPENAI_API_KEY"]
  },
  "ratelimits": [
    {
      "name": "PROGRESSION_RATE_LIMITER",
      "namespace_id": "81427001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "VOICE_RATE_LIMITER",
      "namespace_id": "81427002",
      "simple": {
        "limit": 6,
        "period": 60
      }
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
