# Copy this file to `.dev.vars` at the repository root for local development.
# `.dev.vars*` is gitignored — never commit real keys.
# Wrangler's `secrets.required` filter loads only the provider key below from
# this file. Run `npm run dev:worker` to forward the optional non-secret origin
# as a supported `wrangler dev --var` override.
OPENAI_API_KEY=

# Optional. The production origin (https://harmony.tonari.ai) and localhost
# origins are always permitted by the Worker. Set this only to additively
# allow extra origins (e.g. a staging domain). Comma-separated; "*" allows any.
# Do NOT set this as a Cloudflare secret with an empty value — it's harmless
# either way, but leaving the binding unset keeps the surface minimal.
ALLOWED_ORIGIN=
